# Bookora Environment Configuration
# Copy this file to .env and fill in your actual values.
# DO NOT commit the real .env file to git.
#
# Only the variables marked REQUIRED must be set in production. Everything else
# has a safe default. When DEBUG=False the app refuses to start unless every
# REQUIRED value is present, so a misconfigured deployment fails at boot instead
# of failing quietly on a user's first request.

# ============================================
# APPLICATION (REQUIRED in production)
# ============================================

# REQUIRED. Signs the login session cookie - anyone who knows it can forge a
# logged-in session for any user, so it must be random, secret and per-environment.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret

# False in production, True for local development.
# DEBUG=True also enables the localhost/root/no-password database fallbacks and
# lets the session cookie work over plain HTTP - never enable it on a public host.
DEBUG=False

# Optional: override the port the Flask dev server listens on (default 5000).
# On a PaaS this is supplied by the platform and consumed by the Procfile.
# PORT=5000

# Bookora show availability is always calculated in Asia/Kolkata in code. The
# cloud host itself may use UTC; do not rely on the host's timezone for shows.

# ============================================
# CORS & CROSS-ORIGIN DEPLOYMENT
# ============================================

# Comma-separated list of explicit frontend origins permitted to access APIs cross-origin.
# NEVER use wildcard '*' with credentialed sessions.
# Local development: http://localhost:3000,http://127.0.0.1:3000
# Production: https://bookora-frontend.onrender.com (or custom domain)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set to True when the frontend and backend are hosted on separate Render subdomains
# (e.g. bookora.onrender.com and bookora-backend.onrender.com). Because onrender.com
# is on the Public Suffix List, browsers treat them as cross-site and require
# SameSite=None and Secure=True for session cookies.
# For same-site / custom domains (e.g. app.bookora.com & api.bookora.com) or monolithic,
# keep this False to use the stronger SameSite=Lax protection.
CROSS_SITE_DEPLOYMENT=False

# ============================================
# SESSION COOKIE
# ============================================

# Defaults to True whenever DEBUG=False or when SameSite=None. Set it to False
# only for local plain-HTTP development with SameSite=Lax.
# SESSION_COOKIE_SECURE=True

# 'Lax' (default when CROSS_SITE_DEPLOYMENT=False), or 'None' (when CROSS_SITE_DEPLOYMENT=True).
# SESSION_COOKIE_SAMESITE=Lax

# Optional: set only if sharing cookies across custom subdomains (e.g. .bookora.com).
# DO NOT set a cookie domain for *.onrender.com subdomains.
# SESSION_COOKIE_DOMAIN=.bookora.com

# How long a login lasts in days (default 7).
# SESSION_LIFETIME_DAYS=7

# Set to True only when the app sits behind a reverse proxy / load balancer you
# control, so X-Forwarded-For can be trusted for per-IP OTP rate limiting.
# Leaving it False means every client is rate-limited by its direct peer address.
# When True the app reads the RIGHTMOST X-Forwarded-For entry (the one your edge
# appended); do not enable it unless exactly one trusted proxy fronts the app,
# because with two or more the value read is the inner proxy, which merges all
# clients into one rate-limit bucket.
# TRUST_PROXY_HEADERS=False

# ============================================
# DATABASE (REQUIRED in production)
# Bookora supports both local development (XAMPP MariaDB/MySQL) and
# production cloud hosting (Aiven MySQL 8.4+).
#
# Choose the profile below that matches your deployment environment.
# ============================================

# --------------------------------------------
# PROFILE 1: Local Development (XAMPP defaults)
# --------------------------------------------
# For local development with XAMPP, you can use these settings:
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=bookora
# DB_SSL_DISABLED=True

# --------------------------------------------
# PROFILE 2: Cloud Production (Aiven MySQL on Render / PaaS)
# --------------------------------------------
# Required when deploying to production with Aiven MySQL.
# Fill in your service connection details in your private .env or PaaS dashboard.
# NEVER commit real credentials to Git.
DB_HOST=bookora-db-your-service.d.aivencloud.com
DB_PORT=15053
DB_USER=avnadmin
DB_PASSWORD=your-production-database-password
DB_NAME=bookora

# Connections held per process. Under Gunicorn the total pool size is
# DB_POOL_SIZE x workers (the Procfile uses 4), so keep 4 x this value
# within your database service's max_connections limit.
DB_POOL_SIZE=5

# --------------------------------------------
# DATABASE TLS / SSL (Required for Aiven Production)
# --------------------------------------------
# Aiven MySQL requires encrypted TLS/SSL connections.
# NEVER disable certificate verification in production (keep DB_SSL_VERIFY_CERT=True).
#
# Because `ca.pem` is ignored by Git (*.pem) and must NEVER be committed to GitHub,
# Bookora supports two clean, secure deployment options:
#
# OPTION A: Environment Variable (Recommended on Render / PaaS)
# Set DB_SSL_CA_CERT in the Render Environment Variables dashboard to the full PEM
# certificate text (or paste it with escaped \n sequences). Bookora automatically
# writes it to a temporary file at runtime for verification:
# DB_SSL_CA_CERT="-----BEGIN CERTIFICATE-----\nMIIDUDCCAjigAwIBAgIUZ...\n-----END CERTIFICATE-----"
#
# OPTION B: File Path (Local development or Render Secret Files)
# Point DB_SSL_CA to the certificate file path on disk:
#   - Local development: ca.pem (placed in project root, ignored by git)
#   - Render deployment: /etc/secrets/ca.pem (uploaded via Render Dashboard -> Secret Files)
DB_SSL_CA=ca.pem
DB_SSL_VERIFY_CERT=True

# ============================================
# EMAIL / OTP SIGN-IN (REQUIRED in production)
# Bookora supports two delivery methods:
#
# METHOD 1: HTTPS REST API (RECOMMENDED for Render Free & Cloud Platforms)
# Render Free web services block outbound SMTP ports (25, 465, 587).
# HTTPS-based email APIs transmit over standard port 443 and work reliably on Render Free.
#
#   Option A: Brevo (Sendinblue) - Strongly Recommended for Render Free
#     - Free tier: 300 free emails/day forever (no credit card required).
#     - Crucial feature: sends to ANY recipient email address without requiring a custom domain.
#     - Sign up at https://www.brevo.com -> SMTP & API -> Generate API key (v3).
#     - The sender email must be verified in your Brevo account (Settings -> Senders).
#
#     EMAIL_PROVIDER=brevo
#     BREVO_API_KEY=xkeysib-your-brevo-api-key-here
#     EMAIL_FROM=your-verified-brevo-sender@example.com
#     EMAIL_FROM_NAME=Bookora
#
#   Option B: Resend
#     - Free tier: 100 emails/day, 3,000/month.
#     - Note: without a custom domain, onboarding@resend.dev delivers ONLY to your own account email.
#     - With a verified custom domain, it delivers to any recipient.
#     - Sign up at https://resend.com -> API Keys -> Create API Key.
#
#     EMAIL_PROVIDER=resend
#     RESEND_API_KEY=re_your-resend-api-key-here
#     EMAIL_FROM=onboarding@resend.dev
#     EMAIL_FROM_NAME=Bookora
#
# METHOD 2: SMTP (Recommended for Local Development with XAMPP)
# Local development can connect directly to Gmail SMTP via port 587.
# Get a Gmail app password from: https://myaccount.google.com/apppasswords
#
#     EMAIL_PROVIDER=smtp
#     EMAIL_HOST=smtp.gmail.com
#     EMAIL_PORT=587
#     EMAIL_USER=your-email@gmail.com
#     EMAIL_PASSWORD=your-16-character-gmail-app-password
#     EMAIL_FROM=your-email@gmail.com
#     EMAIL_FROM_NAME=Bookora
# ============================================

# Active provider: 'brevo', 'resend', or 'smtp' (defaults to 'smtp' if omitted)
EMAIL_PROVIDER=brevo

# Brevo configuration (Recommended for Render Free cloud deployment)
BREVO_API_KEY=your-brevo-api-key
EMAIL_FROM=your-verified-sender@example.com
EMAIL_FROM_NAME=Bookora

# Resend configuration (Alternative HTTPS API provider)
# RESEND_API_KEY=your-resend-api-key

# SMTP configuration (Standard for local development with Gmail)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-gmail-app-password


# ============================================
# OTP HARDENING (optional - defaults shown)
#
# SCOPE - which limits are exact, and which are per worker:
#
#   EXACT, cluster-wide (backed by MySQL, survives restarts, no extra infra):
#     * OTP_RESEND_COOLDOWN_SECONDS - anchored on otp_verification.created_at
#     * code invalidation after OTP_MAX_VERIFY_ATTEMPTS wrong guesses
#
#   PER WORKER, in memory (approximate; resets on restart/deploy):
#     * OTP_MAX_SENDS_PER_EMAIL, OTP_MAX_SENDS_PER_IP, OTP_MAX_VERIFIES_PER_IP
#     * the wrong-guess counter that decides when to invalidate
#
# With `gunicorn -w 4` the effective ceiling for the per-worker values is up to 4x
# the number set here, so size them for the worker count. They are development /
# single-instance protection, NOT an exact production control: making them exact
# requires storage shared by all workers and hosts - Redis with flask-limiter is
# the recommended upgrade. The cluster-wide
# cooldown above is what bounds mail volume in the meantime.
# ============================================

# How long a code stays valid.
# OTP_TTL_MINUTES=10
# Wrong guesses allowed before the code is invalidated and a new one is required.
# OTP_MAX_VERIFY_ATTEMPTS=5
# Minimum gap between two "resend code" requests for one address. Enforced
# cluster-wide, and reported to the browser so its Resend countdown matches.
# OTP_RESEND_COOLDOWN_SECONDS=45
# Sliding window that the send/verify caps below are measured over.
# OTP_WINDOW_MINUTES=15
# OTP_MAX_SENDS_PER_EMAIL=5
# OTP_MAX_SENDS_PER_IP=20
# OTP_MAX_VERIFIES_PER_IP=30

# How long a completed OTP verification stays spendable as proof for
# POST /api/complete-profile (signup). Only has to cover form-filling time.
# PENDING_PROFILE_TTL_MINUTES=15
